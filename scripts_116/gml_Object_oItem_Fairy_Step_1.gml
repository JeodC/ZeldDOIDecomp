if (Setup)
{
    ContainX1 = global.Level.Rooms[global.CurrentRoomIndex].x + 8;
    ContainY1 = global.Level.Rooms[global.CurrentRoomIndex].y + 8;
    ContainX2 = global.Level.Rooms[global.CurrentRoomIndex].x2 - 8;
    ContainY2 = global.Level.Rooms[global.CurrentRoomIndex].y2 - 8;
    Setup = false;
}
