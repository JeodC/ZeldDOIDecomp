function Shield_Draw()
{
    if (global.Inventory_ItemData[UnknownEnum.Value_41].Index < 0)
        exit;
    
    if (AghanimTakingItems)
        return false;
    
    if (Cape)
        exit;
    
    switch (State)
    {
        default:
            exit;
        
        case UnknownEnum.Value_0:
        case UnknownEnum.Value_1:
        case UnknownEnum.Value_2:
        case UnknownEnum.Value_12:
        case UnknownEnum.Value_15:
        case UnknownEnum.Value_14:
        case UnknownEnum.Value_16:
        case UnknownEnum.Value_8:
        case UnknownEnum.Value_24:
        case UnknownEnum.Value_25:
        case UnknownEnum.Value_5:
            break;
    }
    
    if (ItemHolding != -4 && instance_exists(ItemHolding))
        exit;
    
    if (oCamera.RoomTransition == 0 || oCamera.OpenTransition)
    {
        var ImgInd = floor(image_index);
        
        switch (State)
        {
            default:
                ShieldDir = Facing;
                break;
            
            case UnknownEnum.Value_14:
                switch (Facing)
                {
                    case 1:
                        ShieldDir = (ImgInd == 0) ? 1 : 4;
                        break;
                    
                    case 2:
                        ShieldDir = (ImgInd == 0) ? 2 : 3;
                        break;
                    
                    case 3:
                    case 4:
                        ShieldDir = 1;
                        break;
                }
                
                break;
            
            case UnknownEnum.Value_12:
            case UnknownEnum.Value_15:
            case UnknownEnum.Value_16:
                switch (Facing)
                {
                    case 1:
                        ShieldDir = 4;
                        break;
                    
                    case 2:
                        ShieldDir = 3;
                        break;
                    
                    case 3:
                    case 4:
                        ShieldDir = 1;
                        break;
                }
                
                break;
        }
        
        var _State = (State == UnknownEnum.Value_0 || State == UnknownEnum.Value_8 || State == UnknownEnum.Value_24 || State == UnknownEnum.Value_25) ? UnknownEnum.Value_1 : ((State == UnknownEnum.Value_5) ? UnknownEnum.Value_2 : State);
        draw_sprite(ShieldSprite[global.Inventory_ItemData[UnknownEnum.Value_41].Index][ShieldDir], 0, x + ShieldOffsetX[_State][Facing][ImgInd], y + ShieldOffsetY[_State][Facing][ImgInd]);
    }
}

function Shield_Hit(arg0, arg1, arg2)
{
    if (global.Inventory_ItemData[UnknownEnum.Value_41].Index == -1)
        return false;
    
    if (State == UnknownEnum.Value_3 || Invincible || Cape || ItemHolding != -4)
        return false;
    
    if (State != UnknownEnum.Value_1 && State != UnknownEnum.Value_2 && State != UnknownEnum.Value_5)
        return false;
    
    switch (arg0.object_index)
    {
        case oBone:
        case oRock:
        case oRedBall:
            if (global.Inventory_ItemData[UnknownEnum.Value_41].Index < 0)
                return false;
            
            break;
        
        case oEnemy_Fireball:
            if (global.Inventory_ItemData[UnknownEnum.Value_41].Index < 1)
                return false;
            
            break;
        
        case oBeam:
        case oEnemy_Fireball2:
            if (global.Inventory_ItemData[UnknownEnum.Value_41].Index < 2)
                return false;
            
            break;
        
        case oEnemy_Beamos:
            if (global.Inventory_ItemData[UnknownEnum.Value_41].Index < 3)
                return false;
            
            break;
    }
    
    var _ShieldHit = false;
    var D = point_direction(x, y - 6, arg1, arg2);
    
    switch (Facing)
    {
        case 1:
            if (D >= 10 && D <= 150)
                _ShieldHit = true;
            
            break;
        
        case 2:
            if (D >= 190 && D <= 320)
                _ShieldHit = true;
            
            break;
        
        case 3:
            if (D >= 120 && D <= 220)
                _ShieldHit = true;
            
            break;
        
        case 4:
            if ((D >= 0 && D <= 55) || (D >= 305 && D < 360))
                _ShieldHit = true;
            
            break;
    }
    
    return _ShieldHit;
}

enum UnknownEnum
{
    Value_0,
    Value_1,
    Value_2,
    Value_3,
    Value_5 = 5,
    Value_8 = 8,
    Value_12 = 12,
    Value_14 = 14,
    Value_15,
    Value_16,
    Value_24 = 24,
    Value_25,
    Value_41 = 41
}
