AltTabCheck();

if (global.AltTab)
    alarm[6]++;

if (input_check_pressed("menu_input") && !keyboard_check(vk_alt))
{
    if (!AllowStart)
    {
        audio_stop_all();
        
        for (var a = 0; a <= 4; a++)
            alarm[a] = 1;
        
        _Contrast = 1;
        _Brightness = 1;
        fx_set_parameter(FX_Contrast, "g_ContrastIntensity", _Contrast);
        fx_set_parameter(FX_Contrast, "g_ContrastBrightness", _Brightness);
        ShowBG = false;
        AllowStart = true;
    }
    else if (!instance_exists(oCredits))
    {
        audio_stop_all();
        room_goto_next();
        exit;
    }
}

if (ShowBG)
{
    _Contrast -= 0.03;
    
    if (_Contrast <= 1)
        _Contrast = 1;
    
    _Brightness += 0.03;
    
    if (_Brightness >= 1)
        _Brightness = 1;
    
    fx_set_parameter(FX_Contrast, "g_ContrastIntensity", _Contrast);
    fx_set_parameter(FX_Contrast, "g_ContrastBrightness", _Brightness);
    
    if (_Contrast == 1 && _Brightness == 1)
    {
        ShowBG = false;
        AllowStart = true;
    }
}
